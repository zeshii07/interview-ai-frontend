{
  "expo": {
    "name": "Hirely",
    "slug": "hirely",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hirely",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.zeeshii_07.hirely"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Hirely to access your microphone for interview answers.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5c4c5ab-26db-4ce1-82ec-484f584ffe11"
      }
    }
  }
}
