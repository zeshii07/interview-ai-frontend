{
  "expo": {
    "name": "Hirely",
    "slug": "hirely",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "hirely",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.zeeshii07.hirely",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Hirely to access your microphone for interview answers.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hirely to access your photos to set your profile picture.",
          "cameraPermission": "Allow Hirely to access your camera to take a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5c4c5ab-26db-4ce1-82ec-484f584ffe11"
      }
    }
  }
}
